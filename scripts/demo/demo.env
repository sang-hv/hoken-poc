# Lớp 2 cho chế độ demo: mọi dịch vụ AI trỏ vào mock server (scripts/demo/mock_ai.py, cổng 8100).
# up.sh nạp file này SAU .env nên ghi đè cấu hình dịch vụ trong .env. Không có key thật.
LLM_TYPE=local
LLM_BASE_URL=http://localhost:8100/v1
LLM_MODEL=mock-gpt
LLM_MINI_MODEL=mock-mini
LLM_VISION_MODEL=mock-vision
LLM_API_KEY=mock-key

EMBEDDING_TYPE=local
EMBEDDING_BASE_URL=http://localhost:8100/v1
EMBEDDING_MODEL=mock-embed
EMBEDDING_DIMS=256

CU_TYPE=azure
CU_ENDPOINT=http://localhost:8100
CU_ANALYZER_ID=prebuilt-layout
CU_AUTH=key
CU_API_KEY=mock-key

SEARCH_TYPE=local
SEARCH_INDEX=hoken_chunks_demo
