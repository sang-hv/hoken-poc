# =====================================================================
# Cấu hình qua biến môi trường — CÙNG MỘT CÁCH cho dev và prod:
#   dev : copy thành .env (đã gitignore)
#   prod: IaC đặt biến; giá trị secret (mật khẩu DB, API key, client secret,
#         JWT secret) lấy từ Key Vault / Secrets Manager qua tham chiếu secret
#         của nền tảng (Container Apps secretRef, `secrets` của ECS task).
# Không hiện trên Admin UI (thiếu biến dịch vụ AI thì Dashboard báo tên biến);
# đổi xong thì khởi động lại API + worker.
#
# Lớp 1 — hạ tầng lõi; Lớp 2 — dịch vụ AI & search, SSO (ở cuối file).
# Lớp 4 (tuỳ chọn pipeline) KHÔNG đặt ở đây — mặc định trong code, Admin chỉ sửa vài ngưỡng trên UI.
# =====================================================================

APP_ENV=dev                          # dev | prod  (prod: không chấp nhận adapter local)
PUBLIC_BASE_URL=http://localhost:8080 # URL người dùng mở UI (dùng cho redirect SSO)
DEV_ALLOWED_HOSTS=                    # chỉ Vite dev: host ngoài được mở UI (tunnel), cách nhau dấu phẩy

# ---- DB: postgres | cosmos | dynamodb
DB_TYPE=postgres
DATABASE_URL=postgresql://hoken:hoken@postgres:5432/hoken
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=hoken
# COSMOS_KEY=                        # trống → Managed Identity
# DYNAMODB_TABLE=hoken
AWS_REGION=ap-northeast-1

# ---- Lưu file: local | azure | s3
BLOB_TYPE=local
BLOB_LOCAL_DIR=out/blob
# AZURE_BLOB_ACCOUNT_URL=https://<storage>.blob.core.windows.net
# AZURE_BLOB_CONTAINER=hoken
# S3_BUCKET=hoken-docs

# ---- Hàng đợi: postgres | azure | sqs
QUEUE_TYPE=postgres
QUEUE_PREFIX=hoken
# AZURE_QUEUE_ACCOUNT_URL=https://<storage>.queue.core.windows.net
# SQS_QUEUE_URL_PREFIX=https://sqs.ap-northeast-1.amazonaws.com/<account>/hoken-
# AZURE_STORAGE_CONNECTION_STRING=   # chỉ khi không dùng Managed Identity

# ---- Parser (標準解析): docling | paddleocr
# Chạy trong worker hàng đợi "docling". Docker: compose build image worker-parser theo giá trị này.
# Chạy ngoài Docker: scripts/dev/setup_parser.sh tạo .venv-parser (Python 3.12) có thư viện tương ứng.
PARSER_TYPE=docling

# ---- Phiên đăng nhập
JWT_SECRET=change-me-at-least-32-characters-long-random
SESSION_HOURS=12
# CORS_ORIGINS=                      # chỉ khi UI và API khác origin

# =====================================================================
# Lớp 2 — dịch vụ AI & search. <COMPONENT>_TYPE chọn adapter (local | azure | aws),
# mỗi trường là <COMPONENT>_<FIELD>. Trống TYPE = chưa cấu hình. Prod không có local.
# Azure: <X>_AUTH=managed_identity (mặc định, không cần key) | key (cần <X>_API_KEY).
# AWS:   <X>_AUTH=iam_role (mặc định) | access_key (cần <X>_ACCESS_KEY_ID / <X>_SECRET_ACCESS_KEY).
# Thiếu biến nào thì Cài đặt → AI サービス báo đúng tên biến đó.
# =====================================================================

# ---- LLM (chat + vision + mini)
LLM_TYPE=
# local:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=  LLM_MINI_MODEL=  LLM_VISION_MODEL=  LLM_API_KEY=
# azure:  LLM_ENDPOINT=https://<resource>.openai.azure.com  LLM_DEPLOYMENT=  LLM_MINI_DEPLOYMENT=
#         LLM_VISION_DEPLOYMENT=  LLM_API_VERSION=2024-10-21  LLM_TEMPERATURE=  LLM_SEED=  LLM_AUTH=managed_identity
# aws:    LLM_REGION=ap-northeast-1  LLM_MODEL_ID=jp.anthropic.claude-sonnet-4-5-20250929-v1:0
#         LLM_MINI_MODEL_ID=  LLM_VISION_MODEL_ID=  LLM_AUTH=iam_role

# ---- Embedding
EMBEDDING_TYPE=
# local:  EMBEDDING_BASE_URL=http://localhost:11434/v1  EMBEDDING_MODEL=  EMBEDDING_DIMS=1024
# azure:  EMBEDDING_ENDPOINT=https://<resource>.openai.azure.com  EMBEDDING_DEPLOYMENT=text-embedding-3-large
#         EMBEDDING_DIMS=1536
# aws:    EMBEDDING_REGION=ap-northeast-1  EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3  EMBEDDING_DIMS=1024

# ---- Content Understanding (luôn Azure)
CU_TYPE=
# azure:  CU_ENDPOINT=https://<resource>.services.ai.azure.com  CU_ANALYZER_ID=prebuilt-layout
#         CU_API_VERSION=2025-11-01  CU_AUTH=managed_identity

# ---- Search hybrid
SEARCH_TYPE=
# local:  SEARCH_INDEX=hoken_chunks  SEARCH_DSN=        # trống → dùng DATABASE_URL
# azure:  SEARCH_ENDPOINT=https://<search>.search.windows.net  SEARCH_INDEX=hoken-chunks  SEARCH_SEMANTIC=true
# aws:    SEARCH_ENDPOINT=https://<domain>.ap-northeast-1.es.amazonaws.com  SEARCH_INDEX=hoken-chunks
#         SEARCH_AUTH=iam_role | access_key | basic (SEARCH_USERNAME / SEARCH_PASSWORD)

# ---- Đăng nhập SSO (bật khi có cả CLIENT_ID và CLIENT_SECRET)
# Redirect URI: <PUBLIC_BASE_URL>/api/auth/oidc/<google|entra>/callback
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_ALLOWED_DOMAINS=example.co.jp     # cách nhau dấu phẩy
# AUTH_GOOGLE_DEFAULT_ROLE=viewer               # viewer | reviewer
# AUTH_ENTRA_TENANT_ID=
# AUTH_ENTRA_CLIENT_ID=
# AUTH_ENTRA_CLIENT_SECRET=
# AUTH_ENTRA_ALLOWED_DOMAINS=
# AUTH_ENTRA_DEFAULT_ROLE=viewer
