# =====================================================================
# Lớp 1 — hạ tầng lõi (DevOps cấu hình lúc deploy, Admin UI chỉ xem)
# Secret ở đây (mật khẩu DB, master key, JWT secret) trên cloud lấy từ
# Key Vault / Secrets Manager và được nền tảng đưa vào biến môi trường
# (tham chiếu Key Vault của Container Apps, `secrets` của ECS task definition).
# Ở local: copy thành .env (đã gitignore).
#
# Lớp 2 (LLM, embedding, CU, search, SSO) và lớp 4 (tuỳ chọn pipeline)
# KHÔNG đặt ở đây — Admin cấu hình trên UI (Cài đặt).
# =====================================================================

APP_ENV=dev                          # dev | prod  (prod: ẩn lựa chọn Local trên UI)
PUBLIC_BASE_URL=http://localhost:8080 # URL người dùng mở UI (dùng cho redirect SSO)
DEV_ALLOWED_HOSTS=                    # chỉ Vite dev: host ngoài được mở UI (tunnel), cách nhau dấu phẩy

# ---- DB: postgres | cosmos | dynamodb
DB_TYPE=postgres
DATABASE_URL=postgresql://hoken:hoken@postgres:5432/hoken
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=hoken
# COSMOS_KEY=                        # trống → Managed Identity
# DYNAMODB_TABLE=hoken
AWS_REGION=ap-northeast-1

# ---- Lưu file: local | azure | s3
BLOB_TYPE=local
BLOB_LOCAL_DIR=out/blob
# AZURE_BLOB_ACCOUNT_URL=https://<storage>.blob.core.windows.net
# AZURE_BLOB_CONTAINER=hoken
# S3_BUCKET=hoken-docs

# ---- Hàng đợi: postgres | azure | sqs
QUEUE_TYPE=postgres
QUEUE_PREFIX=hoken
# AZURE_QUEUE_ACCOUNT_URL=https://<storage>.queue.core.windows.net
# SQS_QUEUE_URL_PREFIX=https://sqs.ap-northeast-1.amazonaws.com/<account>/hoken-
# AZURE_STORAGE_CONNECTION_STRING=   # chỉ khi không dùng Managed Identity

# ---- Secret: local | azure_keyvault | aws_secrets
SECRET_BACKEND=local
SECRET_MASTER_KEY=change-me-32-bytes-base64-or-any-long-string
# KEY_VAULT_URL=https://<vault>.vault.azure.net
# AWS_SECRETS_PREFIX=hoken/

# ---- Phiên đăng nhập
JWT_SECRET=change-me-at-least-32-characters-long-random
SESSION_HOURS=12
# CORS_ORIGINS=                      # chỉ khi UI và API khác origin
