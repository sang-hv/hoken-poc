# Chỉ endpoint và tên deployment. Không để key ở đây:
# trong cloud session, key do network secret của environment gắn vào request;
# trên máy local thì đặt key trong .env (đã có trong .gitignore).
AZURE_REGION=japaneast
AZURE_AI_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com
AOAI_CHAT_DEPLOYMENT=gpt-5x-standard
AOAI_MINI_DEPLOYMENT=gpt-5x-mini-standard
AOAI_EMBED_DEPLOYMENT=text-embedding-3-large-standard
EMBED_DIMENSIONS=1536
CU_ANALYZER=prebuilt-layout
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_INDEX=hoken-r8
BLOB_ACCOUNT_URL=https://<your-storage>.blob.core.windows.net
RUN_MODE=worker   # worker | job
# AZURE_AI_KEY=...   (chỉ dùng trên máy local)
