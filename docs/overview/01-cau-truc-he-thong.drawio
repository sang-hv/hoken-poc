Top=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1130" y="80" width="280" height="780" as="geometry" /></mxCell><mxCell id="cu" value="&lt;b&gt;Azure Content Understanding&lt;/b&gt;&lt;br&gt;đọc trang khó:&lt;br&gt;layout · bảng · hình&lt;br&gt;&lt;i&gt;(luôn dùng Azure)&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#E8F1FB;strokeColor=#0078D4;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1150" y="130" width="240" height="110" as="geometry" /></mxCell><mxCell id="llm" value="&lt;b&gt;LLM&lt;/b&gt;&lt;br&gt;GPT-5.x (Azure OpenAI)&lt;br&gt;dự phòng: Claude (Bedrock &lt;b&gt;jp.&lt;/b&gt;)&lt;br&gt;chia chunk · đọc hình · trả lời" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#E8F1FB;strokeColor=#0078D4;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1150" y="285" width="240" height="115" as="geometry" /></mxCell><mxCell id="emb" value="&lt;b&gt;Embedding&lt;/b&gt;&lt;br&gt;text-embedding-3-large&lt;br&gt;biến chữ → vector" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#E8F1FB;strokeColor=#0078D4;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1150" y="450" width="240" height="85" as="geometry" /></mxCell><mxCell id="c13" value="gọi AI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.5;fontSize=11;fontColor=#4A5361;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.33;" edge="1" parent="1" source="wk" target="AI"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="hỏi LLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.5;fontSize=11;fontColor=#4A5361;labelBackgroundColor=#FFFFFF;dashed=1;entryX=0;entryY=0.75;" edge="1" parent="1" source="bot" target="llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="700" /><mxPoint x="1110" y="370" /></Array></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;Cách đọc&lt;/b&gt;: &lt;span style='background:#FFF4E5;border:1px solid #D9922E'&gt;&amp;nbsp;Cam&amp;nbsp;&lt;/span&gt; = code của team · &lt;span style='background:#EAF5EA;border:1px solid #4C9A4C'&gt;&amp;nbsp;Xanh lá&amp;nbsp;&lt;/span&gt; = người thao tác · &lt;span style='background:#E8F1FB;border:1px solid #0078D4'&gt;&amp;nbsp;Xanh dương&amp;nbsp;&lt;/span&gt; = dịch vụ cloud / AI · &lt;span style='background:#F5F7FA;border:1px solid #8C959F'&gt;&amp;nbsp;Xám&amp;nbsp;&lt;/span&gt; = nơi lưu dữ liệu · Khung / mũi tên nét đứt = bên ngoài, tuỳ chọn hoặc đang làm" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=12;fontColor=#4A5361;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1400" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Luồng xử lý"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="&lt;b&gt;Luồng xử lý — từ PDF đến câu trả lời&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry" /></mxCell><mxCell id="c2" value="Pipeline &lt;b&gt;tự chạy từ đầu đến cuối&lt;/b&gt; (OCR → chunk → embedding → index), không chờ người duyệt. Chỗ nào confidence thấp hơn ngưỡng cài đặt thì hiện &lt;b&gt;⚠ cảnh báo&lt;/b&gt; để người dùng sửa hoặc bỏ qua." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=13;fontColor=#57606A;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1400" height="22" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Khu A — nạp tài liệu&lt;/b&gt; (tự động)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=12;fontColor=#4A5361;fontSize=15;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="400" height="24" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;① Upload&lt;/b&gt;&lt;br&gt;PDF / ảnh" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#EAF5EA;strokeColor=#4C9A4C;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="170" height="90" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;② Docling&lt;/b&gt;&lt;br&gt;đọc từng trang,&lt;br&gt;chấm điểm chất lượng" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#FFF4E5;strokeColor=#D9922E;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="170" height="90" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;③ Trang dễ&lt;br&gt;hay khó?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rhombus;fillColor=#FFF4E5;strokeColor=#D9922E;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="170" height="110" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;④ CU + vision&lt;/b&gt;&lt;br&gt;đọc lại trang khó&lt;br&gt;(bảng, hình, scan)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#E8F1FB;strokeColor=#0078D4;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="170" height="90" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;⑤ Nối trang&lt;/b&gt;&lt;br&gt;gộp đoạn, ghép bảng&lt;br&gt;bị ngắt trang" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#FFF4E5;strokeColor=#D9922E;align=center;