parent="1" source="r" target="d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.5;fontSize=11;fontColor=#4A5361;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="k" target="d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Ngưỡng&lt;/b&gt; (chỉnh trong Admin): dưới &lt;b&gt;0.6&lt;/b&gt; → AI tự đọc lại trong pipeline · dưới &lt;b&gt;0.8&lt;/b&gt; → gắn ⚠ cảnh báo. Câu trả lời chat trích từ trang còn ⚠ cũng hiện ⚠ kèm link để kiểm tra.&lt;br&gt;&lt;b&gt;Trang &quot;dễ&quot;&lt;/b&gt;: điểm Docling ≥ 0.8 · PDF số (không phải scan) · không bảng gộp ô / tràn trang · không hình lớn (đã bỏ logo, con dấu, chữ ký)." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=6;fillColor=#FFFBEA;strokeColor=#E3C565;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="685" width="1290" height="55" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;Khu B — hỏi đáp&lt;/b&gt; (đang làm)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=12;fontColor=#4A5361;fontSize=15;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="400" height="24" as="geometry" /></mxCell><mxCell id="b1" value="&lt;b&gt;Câu hỏi&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#EAF5EA;strokeColor=#4C9A4C;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="170" height="70" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Tìm căn cứ&lt;/b&gt;&lt;br&gt;hybrid: từ khoá + vector" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#FFF4E5;strokeColor=#D9922E;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="800" width="170" height="70" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;Đủ căn cứ?&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rhombus;fillColor=#FFF4E5;strokeColor=#D9922E;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="790" width="170" height="90" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;LLM trả lời&lt;/b&gt;&lt;br&gt;chỉ từ căn cứ,&lt;br&gt;kèm trích dẫn [n]" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#E8F1FB;strokeColor=#0078D4;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="800" width="170" height="70" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b&gt;Trả lời&lt;/b&gt;&lt;br&gt;+ trang tài liệu gốc" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#EAF5EA;strokeColor=#4C9A4C;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="910" y="800" width="170" height="70" as="geometry" /></mxCell><mxCell id="b6" value="&lt;b&gt;Chuyển CSKH&lt;/b&gt;&lt;br&gt;không trả lời bừa" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#8C959F;dashed=1;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1130" y="800" width="170" height="70" as="geometry" /></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.5;fontSize=11;fontColor=#4A5361;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.5;fontSize=11;fontColor=#4A5361;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative