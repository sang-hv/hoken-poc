1"><mxGeometry x="430" y="240" width="640" height="160" as="geometry" /></mxCell><mxCell id="wd" value="&lt;b&gt;worker-docling&lt;/b&gt;&lt;br&gt;② đọc PDF bằng Docling,&lt;br&gt;chấm điểm từng trang" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#FFF4E5;strokeColor=#D9922E;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="285" width="190" height="100" as="geometry" /></mxCell><mxCell id="wl" value="&lt;b&gt;worker-light&lt;/b&gt;&lt;br&gt;③ định tuyến trang&lt;br&gt;⑤ nối trang" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#FFF4E5;strokeColor=#D9922E;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="285" width="190" height="100" as="geometry" /></mxCell><mxCell id="wa" value="&lt;b&gt;worker-ai&lt;/b&gt; ×2&lt;br&gt;④ CU · ⑥ kiểm tra&lt;br&gt;⑧ chunk · ⑩ index" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=10;fillColor=#FFF4E5;strokeColor=#D9922E;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="285" width="180" height="100" as="geometry" /></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.5;fontSize=11;fontColor=#4A5361;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ops" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c4" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.5;fontSize=11;fontColor=#4A5361;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c5" value="xếp job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.5;fontSize=11;fontColor=#4A5361;labelBackground