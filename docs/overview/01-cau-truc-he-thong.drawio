<mxfile host="app.diagrams.net"><diagram id="p0" name="1. Tổng quan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="&lt;b&gt;保険AI Bot — Cấu trúc hệ thống&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry" /></mxCell><mxCell id="c2" value="Bot hỏi đáp 点数 nha khoa (保険), tích hợp vào Apotool · Khu A nạp tài liệu (tự chạy hết, đã chạy) → Khu B hỏi đáp (đang làm)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=13;fontColor=#57606A;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1200" height="22" as="geometry" /></mxCell><mxCell id="ops" value="Người vận hành&lt;br&gt;/ người dùng" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;shape=umlActor;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#4A5361;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="30" height="60" as="geometry" /></mxCell><mxCell id="staff" value="Nhân viên&lt;br&gt;phòng khám" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;shape=umlActor;whiteSpace=nowrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#4A5361;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="670" width="30" height="60" as="geometry" /></mxCell><mxCell id="A" value="&lt;b&gt;A. Nạp tài liệu&lt;/b&gt; — biến PDF của MHLW thành dữ liệu bot đọc được" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;fontColor