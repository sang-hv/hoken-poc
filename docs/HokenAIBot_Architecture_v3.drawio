<mxfile host="app.diagrams.net"><diagram id="arch" name="Kiến trúc tổng quát"><mxGraphModel dx="1600" dy="935" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1215" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;保険AI Bot · PoC — Kiến trúc tổng thể (phiên bản 3: Docling + CU + agentic chunking)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=20;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="Mọi dữ liệu lưu và xử lý tại Nhật · LLM dùng deployment Standard ở Azure Japan East · Bước không chắc chắn đều qua người review" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=13;fontColor=#57606A;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1500" height="22" as="geometry"/></mxCell><mxCell id="region" value="&lt;b&gt;Azure · Japan East — mọi dữ liệu lưu và xử lý tại Nhật&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=2;fillColor=none;strokeColor=#0078D4;strokeWidth=2;dashed=1;verticalAlign=bottom;align=right;labelPosition=center;verticalLabelPosition=top;fontColor=#0078D4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="160" y="80" width="1520" height="960" as="geometry"/></mxCell><mxCell id="ops" value="Người vận hành&lt;br&gt;/ chuyên gia" style="html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1F2328;shape=image;aspect=fixed;imageAspect=0;image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="52" y="160" width="48" height="48" as="geometry"/></mxCell><mxCell id="staff" value="Nhân viên&lt;br&gt;phòng khám&lt;br&gt;· Khách hàng" style="html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1F2328;shape=image;aspect=fixed;imageAspect=0;image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="52" y="660" width="48" height="48" as="geometry"/></mxCell><mxCell id="laneA" value="&lt;b&gt;A. Nạp tài liệu — hệ thống DEHA build (upload, review, chunk)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=13;fontColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="175" y="100" width="1490" height="485" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;① Upload + Docling&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;rounded=1;arcSize=3;fillColor=#F5F7FA;strokeColor=#C3CAD3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=15;" vertex="1" parent="1"><mxGeometry x="190" y="135" width="250" height="440" as="geometry"/></mxCell><mxCell id="webapp" value="&lt;b&gt;Admin UI&lt;/b&gt; (ReactJS)&lt;br&gt;+ Ingestion API&lt;br&gt;upload · review · bật/tắt" style="html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1F2328;shape=image;aspect=fixed;imageAspect=0;image=img/lib/azure2/other/Container_App_Environments.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="180" width="44" height="44" as="geometry"/></mxCell><mxCell id="docling" value="&lt;b&gt;Docling&lt;/b&gt; (self-host)&lt;br&gt;layout · bảng · OCR&lt;br&gt;bỏ logo, con dấu, chữ ký" style="html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1F2328;shape=image;aspect=fixed;imageAspect=0;image=img/lib/azure2/other/Container_App_Environments.svg;labelPosition=right;verticalLabelPosition=middle;align=left;vertica