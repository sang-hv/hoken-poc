rage_Accounts.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="195" y="960" width="40" height="40" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;DB review&lt;/b&gt; (Cosmos DB / SQL)&lt;br&gt;trạng thái · lịch sử sửa" style="html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1F2328;shape=image;aspect=fixed;imageAspect=0;image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="960" width="40" height="40" as="geometry"/></mxCell><mxCell id="loga" value="&lt;b&gt;Log Analytics&lt;/b&gt; (audit)&lt;br&gt;hỏi đáp · truy cập dữ liệu" style="html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1F2328;shape=image;aspect=fixed;imageAspect=0;image=img/lib/azure2/management_governance/Log_Analytics_Workspaces.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="960" width="40" height="40" as="geometry"/></mxCell><mxCell id="kv" value="&lt;b&gt;Key Vault + Entra ID&lt;/b&gt;&lt;br&gt;khoá bí mật · phân quyền" style="html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1F2328;shape=image;aspect=fixed;imageAspect=0;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="960" width="40" height="40" as="geometry"/></mxCell><mxCell id="appcfg" value="&lt;b&gt;App Configuration&lt;/b&gt;&lt;br&gt;cờ bật/tắt · ngưỡng" style="html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontColor=#1F2328;shape=image;aspect=fixed;imageAspect=0;image=img/lib/azure2/integration/App_Configuration.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="960" width="40" height="40" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Cách đọc sơ đồ&lt;/b&gt;&lt;br&gt;• Icon = dịch vụ Azure (Japan East) · Ô cam = code của team · Ô xanh lá = người review · Khung nét đứt = hệ thống bên ngoài&lt;br&gt;• Mọi LLM (GPT-5.x, GPT-5.x vision, embedding) dùng deployment &lt;b&gt;Standard&lt;/b&gt; ở Japan East, nên dữ liệu được xử lý trong Nhật. Không dùng Global / Data Zone&lt;br&gt;• Dự phòng nếu Japan East không có Standard: Claude trên Amazon Bedrock, profile &lt;b&gt;jp.&lt;/b&gt; (Tokyo / Osaka), gọi từ code (CU chỉ nhận model GPT)&lt;br&gt;• Container Apps và AI Search Serverless tự về 0 khi không dùng · Cờ trong App Configuration bật/tắt Foundry IQ, ngưỡng reranker, chuyển người mà không cần deploy lại&lt;br&gt;• Agent loop chunking tối đa 20 vòng, đạt luật thì dừng · Câu không đủ căn cứ luôn được chuyển người, không bỏ lửng" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2328;text;align=left;verticalAlign=top;fontSize=12.5;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="20" y="1050" width="1640" height="140" as="geometry"/></mxCell><mxCell id="e_ops" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.6;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="webapp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_wd" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.6;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="webapp" target="docling"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_dr" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#4A5361;strokeWidth=1.6;exitX=1.000;exitY=0.239;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;en